# ---- Supabase (https://supabase.com/dashboard → Project settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=            # public project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public anon key (safe in the browser; RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY. Bypasses RLS. Never expose or commit.

# ---- viaSocket (https://flow.viasocket.com/integrations → your project → Configuration → Create new embed) ----
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=              # SERVER ONLY signing secret. Anyone holding it can act as any of your users.

# ---- Optional: AI for natural-language requests and drafts. The app works without it (form + offline parser). ----
LLM_API_KEY=                         # SERVER ONLY
LLM_MODEL=claude-sonnet-4-6          # any model your key can use
LLM_BASE_URL=https://api.anthropic.com

# ---- Durable worker ----
CRON_SECRET=                         # random string; Vercel sends it as "Authorization: Bearer <value>" to /api/cron/advance
NEXT_PUBLIC_SITE_URL=http://localhost:3000
